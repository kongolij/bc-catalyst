{
    "name":  "@ges/contentful-record-picker",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "dev":  "vite --host 0.0.0.0",
                    "build":  "tsc -b \u0026\u0026 vite build",
                    "create-app-definition":  "contentful-app-scripts create-app-definition",
                    "upload":  "contentful-app-scripts upload --bundle-dir ./dist",
                    "upload-ci":  "contentful-app-scripts upload --bundle-dir ./dist --ci",
                    "activate":  "contentful-app-scripts activate",
                    "typecheck":  "tsc -b --pretty false"
                },
    "dependencies":  {
                         "@contentful/app-sdk":  "^4.69.0",
                         "@contentful/field-editor-rich-text":  "6.4.1",
                         "@lingui/core":  "^6.6.0",
                         "@lingui/message-utils":  "^6.6.0",
                         "@tanstack/react-query":  "^5.0.0",
                         "react":  "^19.2.8",
                         "react-dom":  "^19.2.8"
                     },
    "devDependencies":  {
                            "@contentful/app-scripts":  "^4.1.8",
                            "@types/react":  "^19.2.18",
                            "@types/react-dom":  "^19.2.4",
                            "@vitejs/plugin-react":  "^6.1.0",
                            "typescript":  "^7.0.2",
                            "vite":  "^8.2.2"
                        },
    "overrides":  {
                      "slate":  "0.94.1",
                      "slate-react":  "0.102.0"
                  }
}
